      "method": "plate",
      "descriptor": "(Lfr/sao/teleport/TeleportClient$Point;FFF)[F",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "point-draw",
      "class": "fr/sao/teleport/TeleportScreen",
      "method": "drawPoint",
      "descriptor": "(Lfr/sao/teleport/TeleportClient$Point;FFFF)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1,
      "capture": "world"
    },
    {
      "id": "rift-draw",
      "class": "fr/sao/teleport/TeleportScreen",
