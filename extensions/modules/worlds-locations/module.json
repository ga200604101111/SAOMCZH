      "argument": 4
    },
    {
      "id": "boss-plain",
      "class": "fr/sao/saoui/mob/BossHud",
      "method": "plain",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "names",
      "capture": "world"
    },
    {
      "id": "boss-visible-text",
      "class": "fr/sao/saoui/mob/BossHud",
      "method": "saoText",
      "descriptor": "(Lnet/minecraft/class_332;DLjava/lang/String;[IFFFIF)V",
