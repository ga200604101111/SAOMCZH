{
  "schema_version": 1,
  "id": "worlds-locations",
  "version": "1.6.0",
  "name": "世界與地點",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "跨服世界名稱、傳送點標籤與相同標籤的量測",
    "地圖與所有區域 HUD 尚未全部介接",
    "Direct domain text display entries discovered by javap from SAOUI 2.41.2; exact dictionary translation only.",
    "Opt-in local untranslated-text observation: world domain; bounded asynchronous writer, no chat, no automatic upload; requires external Runtime1.2."
  ],
  "hooks": [
    {
      "id": "server-title",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "title",
      "descriptor": "(FLjava/lang/String;)V",
      "kind": "argument",
      "section": "names",
      "argument": 1
    },
    {
      "id": "point-measure",
      "class": "fr/sao/teleport/TeleportScreen",
      "method": "plate",
      "descriptor": "(Lfr/sao/teleport/TeleportClient$Point;FFF)[F",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "point-draw",
      "class": "fr/sao/teleport/TeleportScreen",
      "method": "drawPoint",
      "descriptor": "(Lfr/sao/teleport/TeleportClient$Point;FFFF)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1,
      "capture": "world"
    },
    {
      "id": "rift-draw",
      "class": "fr/sao/teleport/TeleportScreen",
      "method": "drawRift",
      "descriptor": "(Lfr/sao/teleport/TeleportClient$Point;FFFF)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 3
    },
    {
      "id": "transfer-duration",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "duration",
      "descriptor": "(J)Ljava/lang/String;",
      "kind": "return",
      "section": "names"
    },
    {
      "id": "point-confirm",
      "class": "fr/sao/teleport/TeleportScreen",
      "method": "method_25406",
      "descriptor": "(DDI)Z",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/teleport/TeleportClient$Point",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1,
      "capture": "world"
    },
    {
      "id": "transfer-header-here",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "method_25394",
      "descriptor": "(Lnet/minecraft/class_332;IIF)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/interlink/InterlinkClient",
      "member": "here",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "transfer-header-there",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "method_25394",
      "descriptor": "(Lnet/minecraft/class_332;IIF)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/interlink/InterlinkClient",
      "member": "there",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "transfer-subtitle",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "twoLines",
      "descriptor": "(FFLjava/lang/String;Ljava/lang/String;FII)V",
      "kind": "argument",
      "section": "names",
      "argument": 3
    },
    {
      "id": "transfer-empty-line",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "emptyRow",
      "descriptor": "(FFLjava/lang/String;Ljava/lang/String;)V",
      "kind": "argument",
      "section": "names",
      "argument": 3
    },
    {
      "id": "compass-title",
      "class": "fr/sao/questtracker/hud/QuestCompassRenderer",
      "method": "render",
      "descriptor": "(Lnet/minecraft/class_332;Lfr/sao/questtracker/model/QuestHudState;Lnet/minecraft/class_2561;Lnet/minecraft/class_2561;Lnet/minecraft/class_2561;F)V",
      "kind": "argument",
      "section": "lines",
      "argument": 2
    },
    {
      "id": "compass-objective",
      "class": "fr/sao/questtracker/hud/QuestCompassRenderer",
      "method": "render",
      "descriptor": "(Lnet/minecraft/class_332;Lfr/sao/questtracker/model/QuestHudState;Lnet/minecraft/class_2561;Lnet/minecraft/class_2561;Lnet/minecraft/class_2561;F)V",
      "kind": "argument",
