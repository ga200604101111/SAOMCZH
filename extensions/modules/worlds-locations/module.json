{
  "schema_version": 1,
  "id": "worlds-locations",
  "version": "1.7.0",
  "name": "世界與地點",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "跨服世界名稱、傳送點標籤與相同標籤的量測",
    "地圖與所有區域 HUD 尚未全部介接",
    "Direct domain text display entries discovered by javap from SAOUI 2.41.2; exact dictionary translation only.",
    "Opt-in local untranslated-text observation: world domain; bounded asynchronous writer, no chat, no automatic upload; requires external Runtime1.2.",
    "World text: vanilla 1.21.4 TextDisplay pre-wrap projection and epoch-only refresh of its cached lines; does not modify server/entity metadata.",
    "SAOJob hologram: parseLegacySectionFormatting String input and styled Text result, ahead of font measurement; unknown entities/player names remain unchanged.",
    "ArmorStand hologram-like nametags: project only field_53337 of its client render-state after superclass extraction; never touch player or server entities."
  ],
  "hooks": [
    {
      "id": "server-title",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "title",
      "descriptor": "(FLjava/lang/String;)V",
      "kind": "argument",
      "section": "names",
      "argument": 1
    },
    {
      "id": "point-measure",
