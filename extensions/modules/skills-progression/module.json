{
  "schema_version": 1,
  "id": "skills-progression",
  "version": "1.1.2",
  "name": "技能與成長",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "技能詳情名稱、描述原文、數值說明欄位",
    "技能樹原有功能仍由外部相容模組提供；非本輪已完全拆開"
  ],
  "hooks": [
    {
      "id": "skill-title",
      "class": "com/eighteen/saojob/skills/SkillDetailPopup",
      "method": "renderPopup",
      "descriptor": "(Lnet/minecraft/class_332;II)V",
      "kind": "field",
      "section": "names",
      "member_class": "com/eighteen/saojob/skills/SkillsData$SkillEntry",
      "member": "name",
      "member_descriptor": "Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "skill-description",
      "class": "com/eighteen/saojob/skills/SkillDetailPopup",
      "method": "descLines",
      "descriptor": "()Ljava/util/List;",
      "kind": "field",
      "section": "lines",
      "member_class": "com/eighteen/saojob/skills/SkillsData$SkillEntry",
      "member": "description",
      "member_descriptor": "Ljava/lang/String;",
      "sites": 3
    },
    {
      "id": "skill-stat-name",
      "class": "com/eighteen/saojob/skills/SkillDetailPopup",
      "method": "renderStats",
      "descriptor": "(Lnet/minecraft/class_332;)V",
      "kind": "field",
      "section": "messages",
      "member_class": "com/eighteen/saojob/skills/SkillsData$SkillStat",
      "member": "name",
      "member_descriptor": "Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "profile-class",
      "class": "fr/sao/equipment/EquipmentPanel",
      "method": "buildInfoLines",
      "descriptor": "(Lfr/sao/equipment/EquipmentClient$State;)Ljava/util/List;",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/equipment/EquipmentClient$State",
      "member": "playerClass",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "profile-cached-class",
      "class": "fr/sao/equipment/EquipmentPanel",
      "method": "unfold",
      "descriptor": "(Ljava/lang/String;FFFFI)V",
      "kind": "argument",
      "section": "names",
      "argument": 0
    },
    {
      "id": "profile-left-label",
      "class": "fr/sao/equipment/EquipmentPanel",
      "method": "buildInfoLines",
      "descriptor": "(Lfr/sao/equipment/EquipmentClient$State;)Ljava/util/List;",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/equipment/EquipmentPanel",
      "member": "text",
      "member_descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "sites": 5
    },
    {
      "id": "profile-left-cached",
      "class": "fr/sao/equipment/EquipmentPanel",
      "method": "unfold",
      "descriptor": "(Ljava/lang/String;FFFF)V",
      "kind": "argument",
      "argument": 0,
      "section": "names"
    }
  ]
}
