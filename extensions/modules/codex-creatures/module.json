{
  "schema_version": 1,
  "id": "codex-creatures",
  "version": "1.2.0",
  "name": "圖鑑與生物",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "圖鑑名稱、描述、分類、掉落名稱",
    "透過動態翻譯模組共同處理生物名稱；特殊外部圖鑑尚未全覆蓋",
    "Direct domain text display entries discovered by javap from SAOUI 2.41.2; exact dictionary translation only."
  ],
  "hooks": [
    {
      "id": "entry-name",
      "class": "fr/sao/codex/CodexScreen",
      "method": "localName",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)Ljava/lang/String;",
      "kind": "return",
      "section": "names"
    },
    {
      "id": "entry-lore",
      "class": "fr/sao/codex/CodexScreen",
      "method": "localLore",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)Ljava/lang/String;",
      "kind": "return",
      "section": "lines"
    },
    {
      "id": "universe",
      "class": "fr/sao/codex/CodexScreen",
      "method": "universeName",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "names"
    },
    {
      "id": "category-name",
      "class": "fr/sao/codex/CodexScreen",
      "method": "catText",
      "descriptor": "(Lfr/sao/codex/CodexClient$Category;)Lfr/sao/codex/CodexScreen$CatText;",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/codex/CodexClient$Category",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "loot-name",
      "class": "fr/sao/codex/CodexScreen",
      "method": "drawSheetBody",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)V",
      "kind": "call",
      "section": "items",
      "member_class": "fr/sao/codex/CodexClient$Loot",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "sheet-category",
      "class": "fr/sao/codex/CodexScreen",
      "method": "drawSheetBody",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)V",
      "kind": "call",
      "section": "names",
      "member_class": "fr/sao/codex/CodexClient$Category",
      "member": "name",
      "member_descriptor": "()Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "codex-row-value",
      "class": "fr/sao/codex/CodexScreen",
      "method": "rowValue",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)Ljava/lang/String;",
      "kind": "return",
      "section": "lines"
    }
  ]
}
