{
  "schema_version": 1,
  "id": "codex-creatures",
  "version": "1.8.0",
  "name": "圖鑑與生物",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "圖鑑名稱、描述、分類、掉落名稱",
    "透過動態翻譯模組共同處理生物名稱；特殊外部圖鑑尚未全覆蓋",
    "Direct domain text display entries discovered by javap from SAOUI 2.41.2; exact dictionary translation only.",
    "Codex category, entry hint and lore UI read sites verified from SAOUI 2.41.2 bytecode; preserve discovery state, date and source IDs.",
    "Opt-in local untranslated-text observation: codex domain; bounded asynchronous writer, no chat, no automatic upload; requires external Runtime1.2."
  ],
  "hooks": [
    {
      "id": "entry-name",
      "class": "fr/sao/codex/CodexScreen",
      "method": "localName",
      "descriptor": "(Lfr/sao/codex/CodexClient$Entry;)Ljava/lang/String;",
      "kind": "return",
      "section": "names",
      "capture": "codex"
    },
    {
      "id": "entry-lore",
      "class": "fr/sao/codex/CodexScreen",
