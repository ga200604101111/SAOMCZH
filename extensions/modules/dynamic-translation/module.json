{
  "schema_version": 1,
  "id": "dynamic-translation",
  "version": "1.0.0",
  "name": "原生動態翻譯補強",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "接原模組翻譯結果；同一入口可服務多種介面",
    "系統訊息僅限原模組 messages，未接玩家聊天原始封包"
  ],
  "dictionary": {},
  "hooks": [
    {
      "id": "names-string",
      "class": "fr/sao/translate/TranslateClient",
      "method": "names",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "locale": "zh_tw",
      "section": "names"
    },
    {
      "id": "wholeName-string",
      "class": "fr/sao/translate/TranslateClient",
      "method": "wholeName",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
