{
  "schema_version": 1,
  "id": "items-economy",
  "version": "1.8.1",
  "name": "物品與經濟",
  "enabled": true,
  "dependencies": {
    "shared-terms": "1.0.0"
  },
  "coverage": [
    "背包物品名稱／原生物品翻譯",
    "登入獎勵描述、裝備屬性、跨服物品清單",
    "拍賣商品若使用 ItemLangClient 會共享此模組；排版未在此輪處理",
    "大廳選樓層物品名稱與分色提示，既有物品顯示入口不需更換核心",
    "詳細規格物品名稱與來源；取得來源在共用分行前翻譯，價格保留。",
    "Direct domain text display entries discovered by javap from SAOUI 2.41.2; exact dictionary translation only.",
    "Opt-in local untranslated-text observation: item domain; bounded asynchronous writer, no chat, no automatic upload; requires external Runtime1.2.",
    "Known item-name UI slots omit terminal/prefix stack counts; native quantity widgets and numeric lore remain unchanged. Shared exact dictionary fallback rejects conflicting alternatives."
  ],
  "hooks": [
    {
      "id": "item-knownPlain",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "knownPlain",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "item-plain",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "plain",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "item-translate",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "translate",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "item-name",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "name",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "item-text",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "name",
      "descriptor": "(Lnet/minecraft/class_1799;Lnet/minecraft/class_2561;)Lnet/minecraft/class_2561;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "reward-description",
      "class": "fr/sao/daily/DailyModel$Reward",
      "method": "desc",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "lines",
      "capture": "item"
    },
    {
      "id": "equipment-stat",
      "class": "fr/sao/equipment/EquipmentClient$Stat",
      "method": "name",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "names"
    },
    {
      "id": "transfer-item",
      "class": "fr/sao/interlink/InterlinkScreen",
      "method": "itemName",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "item-lookup",
      "class": "fr/sao/itemlang/ItemLangClient",
      "method": "lookup",
      "descriptor": "(Ljava/lang/String;)Lnet/minecraft/class_2561;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "native-item-name",
      "class": "net/minecraft/class_1799",
      "method": "method_7964",
      "descriptor": "()Lnet/minecraft/class_2561;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "tooltip-name",
      "class": "fr/sao/tooltip/TipModel",
      "method": "name",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "items",
      "capture": "item"
    },
    {
      "id": "tooltip-stat",
      "class": "fr/sao/tooltip/TipModel$Stat",
      "method": "label",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "items",
      "capture": "item"
    },
    {
      "id": "tooltip-display",
      "class": "fr/sao/tooltip/ItemTip",
      "method": "text",
      "descriptor": "(Lfr/sao/pass/screen/PassCanvas;Ljava/lang/String;Ljava/lang/String;FFFI)V",
      "kind": "argument",
      "section": "items",
      "argument": 2
    },
    {
      "id": "detail-info-name",
      "class": "fr/sao/iteminfo/ItemInfoClient$Info",
      "method": "name",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "items",
      "capture": "item"
    },
    {
      "id": "detail-visible-title",
      "class": "fr/sao/iteminfo/ItemInfoOverlay",
      "method": "render",
      "descriptor": "(Lnet/minecraft/class_332;II)V",
      "kind": "field",
      "section": "items",
      "member_class": "fr/sao/iteminfo/ItemInfoOverlay$Layout",
      "member": "upperName",
      "member_descriptor": "Ljava/lang/String;",
      "sites": 1
    },
    {
      "id": "reward-name",
      "class": "fr/sao/daily/DailyModel$Reward",
      "method": "name",
      "descriptor": "()Ljava/lang/String;",
      "kind": "return",
      "section": "items",
      "capture": "item"
    },
    {
      "id": "reward-cached-name",
      "class": "fr/sao/daily/DailyScreen",
      "method": "drawSheet",
      "descriptor": "(Lfr/sao/daily/DailyModel$State;)V",
      "kind": "field",
      "section": "items",
      "member_class": "fr/sao/daily/DailyScreen",
      "member": "sheetName",
      "member_descriptor": "Ljava/lang/String;",
      "sites": 1,
      "capture": "item"
    },
    {
      "id": "auction-item-name",
      "class": "fr/sao/auctions/AuctionScreen",
      "method": "itemName",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "auction-item-lore",
      "class": "fr/sao/auctions/AuctionScreen",
      "method": "itemLore",
      "descriptor": "(Ljava/lang/String;)Ljava/lang/String;",
      "kind": "return",
      "section": "items"
    },
    {
      "id": "daily-reward-described",
      "class": "fr/sao/daily/DailyScreen",
      "method": "describe",
      "descriptor": "(Lfr/sao/daily/DailyModel$Reward;)Ljava/lang/String;",
      "kind": "return",
      "section": "lines",
      "capture": "item"
    }
  ]
}
